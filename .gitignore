# Build trees
build*/

# FetchContent tree when relocated via FETCHCONTENT_BASE_DIR (CI does this
# for caching)
.deps/

# Tooling caches
.cache/
compile_commands.json

# Python (tools/ only; never in the engine or its build)
tools/.venv/
__pycache__/

# Pinned UCD downloads cached by tools/gen_unicode (verified by SHA-256 on
# every run; the generated tables are committed, the inputs are not)
tools/gen_unicode/cache/

# macOS
.DS_Store
